# STONEBOUND — Firebase client configuration (Web app credentials).
#
# Copy this file to `.env` and fill the values from:
#   Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
#
# These are PUBLIC client identifiers (safe to bundle), NOT admin/service-account
# secrets. Never place serviceAccountKey.json or admin credentials in this repo.
#
# For GitHub Pages CI, add the same values as repository secrets
# (Settings → Secrets → Actions: VITE_FIREBASE_API_KEY, etc.) — see README.md.
#
# Until these are filled in, the game automatically runs in Guest/Local mode
# (progress saved to this browser only, no cross-device sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
